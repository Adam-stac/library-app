# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Generate a password with:  openssl rand -base64 24
# Production values live in Coolify and GitHub secrets, never in Git.

POSTGRES_DB=library
POSTGRES_USER=library_app
POSTGRES_PASSWORD=

# Encrypts authenticator-app (2FA) secrets. Generate with:  openssl rand -base64 32
# Losing or changing it means everyone has to set up two-step verification again.
TOTP_ENCRYPTION_KEY=

# Use the browser-test settings (compose.test.yaml) with every "docker compose" command.
COMPOSE_FILE=compose.yaml:compose.test.yaml

# prod = JSON logs, as on the server
SPRING_PROFILES_ACTIVE=prod
