# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Generate a password with:  openssl rand -base64 24
# Production values live in Coolify and GitHub secrets, never in Git.

POSTGRES_DB=library
POSTGRES_USER=library_app
POSTGRES_PASSWORD=

# prod = JSON logs, as on the server
SPRING_PROFILES_ACTIVE=prod
