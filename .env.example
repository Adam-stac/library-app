# Copy this file to .env for local development: cp .env.example .env
# .env is git-ignored. Never put real production values in either file.
# Production values live in GitHub Environment secrets and Coolify, never in Git.

# --- Database (local Docker Compose only; used from Phase 2) ---
POSTGRES_DB=library
POSTGRES_USER=library_app
POSTGRES_PASSWORD=change-me-local-only

# --- API ---
SPRING_PROFILES_ACTIVE=local
